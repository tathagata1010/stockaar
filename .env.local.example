# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay plan IDs (create in Razorpay dashboard)
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=

# Resend (email)
# IMPORTANT: Resend rejects gmail/yahoo/outlook senders. Verify a domain at
# https://resend.com/domains then set EMAIL_FROM=newsletter@yourdomain.com.
# If unset, Resend uses onboarding@resend.dev (deliverable but ugly).
# Display-name form is supported: EMAIL_FROM="Stockaar <onboarding@resend.dev>"
# EMAIL_REPLY_TO routes replies to a real inbox (gmail is fine here).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Cron auth (random secret, sent in Authorization header by Vercel Cron)
CRON_SECRET=

# NVIDIA NIM (free AI brief — get key at https://build.nvidia.com/)
NVIDIA_API_KEY=
# Optional model override (default: meta/llama-3.3-70b-instruct)
NVIDIA_MODEL=

# Groq (preferred agent LLM — real OpenAI-style tool calling + fast LPU
# inference). Get key at https://console.groq.com/keys. When set, the research
# agent uses Groq; when unset, it falls back to NVIDIA NIM (agent-only — the
# non-agent AI Brief always uses NVIDIA).
GROQ_API_KEY=
# Optional per-role model overrides. Defaults:
#   agent   → openai/gpt-oss-120b       (tool orchestration)
#   compose → moonshotai/kimi-k2-instruct (long-form synthesis)
#   brief   → openai/gpt-oss-120b       (one-shot summaries)
#   fast    → llama-3.1-8b-instant      (batch JSON scoring)
AGENT_MODEL_GROQ=
COMPOSE_MODEL_GROQ=

# Serper.dev — Google-results API used by the research agent for live web
# search (concall transcripts, ValuePickr threads, X posts, macro news).
# 2.5K free searches/mo. Get key at https://serper.dev/
# When unset, the web_search / read_url tools return an empty "not configured"
# result and the agent falls back to built-in data sources.
SERPER_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
